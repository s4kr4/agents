# Claude Code の .claude/settings.json にある permissions.allow / deny の
# Bash ルールを Codex execpolicy へ対応付ける。
# 複数ルールに一致した場合は forbidden > prompt > allow の順で優先される。

# permissions.allow
prefix_rule(pattern = ["cd"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["pwd"], decision = "allow")
prefix_rule(pattern = ["tree"], decision = "allow")
prefix_rule(pattern = ["lsmod"], decision = "allow")
prefix_rule(pattern = ["w"], decision = "allow")
prefix_rule(pattern = ["apt", "list"], decision = "allow")
prefix_rule(pattern = ["docker", "compose"], decision = "allow")
prefix_rule(pattern = ["git"], decision = "allow")
prefix_rule(pattern = ["playwright-cli"], decision = "allow")

# permissions.deny
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "sudo による権限昇格は禁止されています",
)
prefix_rule(pattern = ["curl"], decision = "forbidden")
prefix_rule(pattern = ["wget"], decision = "forbidden")
prefix_rule(pattern = ["nc"], decision = "forbidden")
prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "rm による削除は禁止されています",
)
prefix_rule(pattern = ["psql"], decision = "forbidden")
prefix_rule(pattern = ["mysql"], decision = "forbidden")
prefix_rule(pattern = ["mongod"], decision = "forbidden")
prefix_rule(pattern = ["npx"], decision = "forbidden")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden")
prefix_rule(pattern = ["git", "push"], decision = "forbidden")
prefix_rule(pattern = ["git", "reset"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden")
