#!/bin/bash

# util.zsh をソース
if [ -z "${DOTPATH:-}" ]; then
    DOTPATH=~/.dotfiles; export DOTPATH
fi
. "$DOTPATH"/etc/lib/util.zsh

# Claude Code StatusLine Script
# JSONデータを標準入力から受け取る
input=$(cat)

# プロジェクトルートディレクトリ名を取得
project_dir=$(echo "$input" | jq -r '.workspace.project_dir')
if [ -n "$project_dir" ] && [ "$project_dir" != "null" ]; then
    project_name=$(basename "$project_dir")
else
    # プロジェクトディレクトリがない場合は現在のディレクトリ名を使用
    current_dir=$(echo "$input" | jq -r '.workspace.current_dir')
    project_name=$(basename "$current_dir")
fi

# Gitブランチ名を取得（オプショナルロックをスキップ）
current_dir=$(echo "$input" | jq -r '.workspace.current_dir')
if [ -d "$current_dir/.git" ]; then
    git_branch=$(cd "$current_dir" && git -c core.useBuiltinFSMonitor=false branch --show-current 2>/dev/null)
    if [ -z "$git_branch" ]; then
        git_branch=""
    fi
else
    git_branch=""
fi

# モデル表示名を取得
model_name=$(echo "$input" | jq -r '.model.display_name')

# トークン使用量を取得
context_window=$(echo "$input" | jq '.context_window')
context_size=$(echo "$context_window" | jq '.context_window_size')
usage=$(echo "$context_window" | jq '.current_usage')

if [ "$usage" != "null" ]; then
    # 現在のコンテキストトークン数を計算
    current_tokens=$(echo "$usage" | jq '.input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens')
else
    # 新しいセッションの場合はトークン消費量を0とする
    current_tokens=0
fi

# パーセンテージを計算
if [ "$context_size" -gt 0 ]; then
    # トークン数とパーセンテージをk単位で表示（小数第1位まで）
    current_k=$(awk "BEGIN {printf \"%.1f\", $current_tokens / 1000}")
    context_k=$(awk "BEGIN {printf \"%.1f\", $context_size / 1000}")
    pct=$(awk "BEGIN {printf \"%.1f\", ($current_tokens * 100) / $context_size}")
    # printf で % が解釈されないように %% にエスケープ
    token_display="${current_k}k/${context_k}k (${pct}%%)"
else
    token_display="N/A"
fi

# レートリミット使用状況を取得（浮動小数点を整数に丸める）
five_hour_pct=$(echo "$input" | jq -r 'if (.rate_limits.five_hour.used_percentage | type) == "number" then (.rate_limits.five_hour.used_percentage | round | tostring) else "" end')
seven_day_pct=$(echo "$input" | jq -r 'if (.rate_limits.seven_day.used_percentage | type) == "number" then (.rate_limits.seven_day.used_percentage | round | tostring) else "" end')

if [ -n "$five_hour_pct" ] && [ -n "$seven_day_pct" ]; then
    five_hour_rem=$((100 - five_hour_pct))
    seven_day_rem=$((100 - seven_day_pct))
    rate_display="5h:${five_hour_rem}%% rem 7d:${seven_day_rem}%% rem"
else
    rate_display="5h:-- 7d:--"
fi

# 各セクションを変数に格納
# user@host セクション
section_user="$(ink green "$(whoami)@$(hostname -s)")"

# dirname@branchname セクション
if [ -n "$git_branch" ]; then
    section_project="$(ink256 51 "$project_name")⎇ $(ink yellow "$git_branch")"
else
    section_project="$(ink256 51 "$project_name")"
fi

# モデル名セクション
section_model="$(ink256 205 "$model_name")"

# トークン使用量セクション
section_tokens="$(ink purple "⛁ $token_display")"

# レートリミットセクション
section_rate="$(ink256 208 "⚡ $rate_display")"

# セパレーター
sep="$(ink cyan "│")"

# 未処理フィードバック件数セクション（has_signals: true のファイルのみカウント）
fb_count=0
if [ -d "${current_dir}/.claude/skills" ]; then
    fb_count=$(grep -rl "has_signals: true" "${current_dir}/.claude/skills"/*/feedback/*.md 2>/dev/null | grep -v "/applied/" | wc -l | tr -d ' ')
fi
if [ "$fb_count" -gt 0 ]; then
    section_fb=" ${sep} $(ink256 214 "FB:${fb_count}")"
else
    section_fb=""
fi

# ステータスライン出力
# 1行目: user@host │ dirname@branchname │ モデル名
# 2行目: トークン使用量 │ レートリミット
printf "%s\n%s\n" \
    "${section_user} ${sep} ${section_project} ${sep} ${section_model}" \
    "${section_tokens} ${sep} ${section_rate}${section_fb}"

# レートリミット残量をキャッシュへ書き出す
# herdr のタブバー右端から実行される scripts/claude-rate-status が読み取る。
# statusLine が落ちると Claude Code の画面が壊れるため、失敗はすべて握り潰し、
# 標準出力（上記の 2 行）・標準エラーを汚さない。
# rate_limits が入力に無い場合は何も書かず、既存のキャッシュをそのまま残す。
if [ -n "$five_hour_pct" ] && [ -n "$seven_day_pct" ]; then
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-statusline"
    cache_path="$cache_dir/rate-limits"
    # 一時ファイルは同一ディレクトリに置く（別ファイルシステム経由だと
    # mv が rename(2) にならず、読み手に部分状態が見えうるため）
    tmp_path="$cache_path.tmp.$$"
    # token_display / rate_display は printf 用に % をエスケープ済みのため
    # 再利用せず、生の整数から組み立てる
    printf -v updated_at '%(%s)T' -1
    # リダイレクト自体の失敗もシェルが stderr へ書くため、グループごと捨てる
    if {
        mkdir -p "$cache_dir" \
            && printf 'five_hour_remaining=%s\nseven_day_remaining=%s\nupdated_at=%s\n' \
                "$five_hour_rem" "$seven_day_rem" "$updated_at" > "$tmp_path"
    } 2>/dev/null; then
        # cache_path がディレクトリだと mv はその配下へ移動して成功してしまい、
        # 一時ファイルが蓄積するため事前に弾く
        if [ -d "$cache_path" ] || ! mv -f "$tmp_path" "$cache_path" 2>/dev/null; then
            rm -f "$tmp_path" 2>/dev/null || true
        fi
    else
        rm -f "$tmp_path" 2>/dev/null || true
    fi
fi
